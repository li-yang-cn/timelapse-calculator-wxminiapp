.functions {
    margin: 30px;
}

section {
    margin-bottom: 20px;
}

label {
    display: block;
    margin-bottom: 5px;
}

input {
    width: 100%;
    padding: 10px;
    border-radius: 5px;
}

.result {
    margin-top: 20px;
}

button {
    background-color: #444444;
    color: #dddddd;
    border: none;
    border-radius: 5px;
    font-size: 16px;

}

.emoji {
    margin-top: 30px;
    width: 100px;
    height: 100px;
}

.title {
    font-size: 28px;
}

.reset {
    display: flex;
    justify-content: center;
    align-items: center;
}

/* index.wxss */
.container {
    display: flex;
    flex-direction: column;
    width: 100%;
}

.presets {
    margin-top: 18px;
}

.preset-scroll {
    width: 100%;
    white-space: nowrap;
}

.preset-list {
    display: inline-flex;
    padding: 0 18px;
}

.preset-emoji {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    font-size: 24px;
    line-height: 44px;
    margin-right: 10px;
}

.preset-emoji-active {
    opacity: 0.65;
}

.row {
    display: flex;
    align-items: center;
    margin: 15px;
}

.buttons {
    display: flex;
    justify-content: center;
    padding: 0 15px;
}

.icon {
    flex: 1;
    text-align: left;
    /* 确保图标左对齐 */
}

.label {
    flex: 10 2 10%;
    text-align: left;
    /* 确保标签左对齐 */
}

.field-tag {
    min-width: 34px;
    margin-right: 6px;
    padding: 2px 4px;
    border-radius: 4px;
    background-color: #eeeeee;
    color: #666666;
    font-size: 11px;
    line-height: 16px;
    text-align: center;
}

.calculated-row .input,
.calculated-row .picker {
    color: #666666;
}

.input,
.picker {
    flex: 8 5 20%;
    text-align: right;
    /* 输入框和选择器内容左对齐 */
}

.unit {
    flex: 1;
    text-align: left;
    /* 单位左对齐 */
}

.tips {
    margin-top: 20px;
    text-align: center;
    font-size: 12px;
}

.history {
    margin-top: 20px;
    padding: 10px;
    text-align: center;
    font-size: 16px;
}

.history-title {
    margin-bottom: 10px;
}

.table-header,
.table-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 0;
}

.table-row {
    align-items: center;
}

.table-cell {
    flex: 1;
    text-align: center;
    padding: 4px 0;
    font-size: 13px;
    word-break: break-all;
}

.history-list {
    display: flex;
    flex-direction: column;
}

.calc-button,
.reset-button,
.copy-button,
.clear-button {
    flex: 1;
    max-width: 120px;
    margin: 0 5px;
}

.copy-mini-button {
    width: 48px;
    min-width: 48px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    line-height: 28px;
}
