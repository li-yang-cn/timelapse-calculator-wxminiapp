.functions {
    margin: 30px;
}

section {
    margin-bottom: 20px;
}

label {
    display: block;
    margin-bottom: 5px;
}

input {
    width: 100%;
    padding: 10px;
    border-radius: 5px;
}

.result {
    margin-top: 20px;
}

button {
    background-color: #444444;
    color: #dddddd;
    border: none;
    border-radius: 5px;
    font-size: 16px;
    white-space: nowrap;

}

.reset {
    display: flex;
    justify-content: center;
    align-items: center;
}

/* index.wxss */
.container {
    display: flex;
    flex-direction: column;
    width: 100%;
}

.page-heading {
    display: flex;
    align-items: center;
    width: calc(100% - 32px);
}

.page-logo {
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    margin-right: 10px;
}

.title {
    color: #ffffff;
    font-size: 23px;
    font-weight: 600;
}

.presets {
    width: calc(100% - 32px);
    margin-top: 16px;
}

.presets-title {
    margin-bottom: 8px;
    color: #dddddd;
    font-size: 14px;
}

.scene-card,
.more-scenes {
    width: 100%;
    margin: 0 0 6px;
    box-sizing: border-box;
    border: 1px solid #454545;
    border-radius: 8px;
    background-color: #2d2d2d;
    white-space: normal;
}

.scene-card::after,
.more-scenes::after {
    border: 0;
}

.scene-card {
    display: flex;
    align-items: flex-start;
    padding: 7px 10px;
    text-align: left;
}

.scene-card-active,
.scene-card-pressed {
    border-color: #74cab6;
    background-color: #273a36;
}

.scene-emoji {
    flex: 0 0 25px;
    margin-right: 10px;
    font-size: 19px;
    line-height: 22px;
}

.scene-details {
    flex: 1;
    min-width: 0;
}

.scene-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    line-height: 21px;
}

.scene-name {
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
}

.scene-selected {
    color: #a5e5d6;
    font-size: 12px;
}

.scene-note {
    color: #dddddd;
    font-size: 13px;
    line-height: 18px;
}

.scene-reference {
    color: #bdbdbd;
    font-size: 12px;
    line-height: 16px;
}

.more-scenes {
    padding: 9px 10px;
    color: #dddddd;
    font-size: 14px;
    line-height: 24px;
}

.row {
    display: flex;
    align-items: center;
    margin: 15px;
}

.buttons {
    display: flex;
    justify-content: center;
    padding: 0 12px;
}

.icon {
    flex: 1;
    text-align: left;
    /* 确保图标左对齐 */
}

.label {
    flex: 10 2 10%;
    text-align: left;
    /* 确保标签左对齐 */
}

.field-tag {
    min-width: 34px;
    margin-right: 6px;
    padding: 2px 4px;
    border-radius: 4px;
    background-color: #eeeeee;
    color: #666666;
    font-size: 11px;
    line-height: 16px;
    text-align: center;
}

.field-tag-hidden {
    visibility: hidden;
}

.calculated-row .input,
.calculated-row .picker {
    color: #666666;
}

.input,
.picker {
    flex: 8 5 20%;
    text-align: right;
    /* 输入框和选择器内容左对齐 */
}

.unit {
    flex: 1;
    text-align: left;
    /* 单位左对齐 */
}

.tips {
    margin-top: 16px;
    padding: 0 20px;
    text-align: center;
    font-size: 12px;
    color: #aaaaaa;
}

.risk-panel {
    width: calc(100% - 60px);
    margin: 0 30px 18px;
    padding: 12px;
    box-sizing: border-box;
    border-radius: 6px;
    background-color: #2d2d2d;
}

.risk-title {
    margin-bottom: 8px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}

.risk-item {
    margin-top: 6px;
    color: #dddddd;
    font-size: 13px;
    line-height: 1.5;
    text-align: left;
}

.history {
    margin-top: 20px;
    padding: 10px;
    text-align: center;
    font-size: 16px;
}

.history-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 8px;
    border-top: 1px solid #333333;
    border-bottom: 1px solid #333333;
}

.history-title {
    font-size: 15px;
    color: #cccccc;
}

.history-toggle {
    color: #999999;
    font-size: 13px;
}

.empty-history {
    padding: 18px 0;
    color: #888888;
    font-size: 13px;
}

.table-header,
.table-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    padding: 8px 0;
}

.table-row {
    align-items: center;
}

.table-cell {
    flex: 1;
    text-align: center;
    padding: 4px 0;
    font-size: 13px;
    word-break: break-all;
}

.history-list {
    display: flex;
    flex-direction: column;
}

.calc-button,
.reset-button,
.copy-button,
.clear-button {
    flex: 0 0 90px;
    height: 40px;
    margin: 0 3px;
    padding: 0 8px;
    font-size: 15px;
    line-height: 40px;
    box-sizing: border-box;
    white-space: nowrap;
}

.history-actions {
    margin-top: 10px;
}

.share-actions {
    margin-top: 10px;
}

.share-image-button {
    width: 116px;
    height: 40px;
    margin: 0;
    padding: 0 12px;
    font-size: 15px;
    line-height: 40px;
    box-sizing: border-box;
}

.share-canvas {
    position: fixed;
    left: -1000px;
    top: -1000px;
    width: 375px;
    height: 500px;
    pointer-events: none;
}

.copy-mini-button {
    width: 48px;
    min-width: 48px;
    margin: 0;
    padding: 0;
    font-size: 12px;
    line-height: 28px;
}
