.container {
    min-height: 100vh;
    padding: 36rpx 32rpx 90rpx;
    padding-top: calc(36rpx + constant(safe-area-inset-top));
    padding-top: calc(36rpx + env(safe-area-inset-top));
    box-sizing: border-box;
}

.title {
    margin-top: 10rpx;
    color: #ffffff;
    font-size: 26px;
    font-weight: 600;
    text-align: center;
}

.subtitle {
    margin: 18rpx auto 28rpx;
    max-width: 640rpx;
    color: #aaaaaa;
    font-size: 14px;
    line-height: 1.6;
    text-align: center;
}

.notice {
    margin-bottom: 24rpx;
    padding: 20rpx 22rpx;
    border-left: 6rpx solid #777777;
    border-radius: 6px;
    background-color: #2d2d2d;
    color: #dddddd;
    font-size: 13px;
    line-height: 1.6;
}

.section {
    margin-bottom: 24rpx;
    padding: 24rpx;
    border-radius: 6px;
    background-color: #2b2b2b;
}

.section-title {
    margin-bottom: 18rpx;
    color: #ffffff;
    font-size: 17px;
    font-weight: 600;
}

.form-row {
    display: flex;
    align-items: center;
    min-height: 72rpx;
    border-bottom: 1px solid #3a3a3a;
}

.form-row:last-child {
    border-bottom: none;
}

.form-label {
    width: 112rpx;
    min-width: 112rpx;
    color: #ffffff;
    font-size: 14px;
}

.text-input,
.date-picker,
.add-input {
    flex: 1;
    color: #dddddd;
    font-size: 14px;
}

.date-picker {
    min-height: 72rpx;
    line-height: 72rpx;
}

.add-row {
    display: flex;
    align-items: center;
    min-height: 78rpx;
}

.add-input {
    min-height: 72rpx;
}

button {
    background-color: #444444;
    color: #dddddd;
    border: none;
    border-radius: 5px;
    white-space: nowrap;
}

.add-button {
    width: 112rpx;
    height: 58rpx;
    margin: 0 0 0 16rpx;
    padding: 0;
    font-size: 13px;
    line-height: 58rpx;
}

.check-row {
    display: flex;
    align-items: center;
    padding: 16rpx 0;
    border-bottom: 1px solid #3a3a3a;
}

.check-row:last-child {
    border-bottom: none;
}

.check-main {
    display: flex;
    flex: 1;
    align-items: center;
    min-width: 0;
}

.checkbox {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36rpx;
    height: 36rpx;
    min-width: 36rpx;
    margin-right: 16rpx;
    border: 2rpx solid #888888;
    border-radius: 4px;
    color: #ffffff;
    font-size: 13px;
    line-height: 36rpx;
}

.checkbox-checked {
    border-color: #dddddd;
    background-color: #555555;
}

.check-text {
    flex: 1;
    color: #dddddd;
    font-size: 14px;
    line-height: 1.5;
    word-break: break-all;
}

.check-text-done {
    color: #888888;
    text-decoration: line-through;
}

.delete-button {
    width: 92rpx;
    height: 52rpx;
    margin: 0 0 0 16rpx;
    padding: 0;
    color: #cccccc;
    font-size: 12px;
    line-height: 52rpx;
}

.empty-list {
    color: #888888;
    font-size: 13px;
    line-height: 1.6;
}

.buttons {
    display: flex;
    justify-content: center;
    margin-top: 18rpx;
}

.reset-button,
.clear-button {
    width: 150rpx;
    height: 64rpx;
    margin: 0 8rpx;
    padding: 0;
    font-size: 13px;
    line-height: 64rpx;
}
